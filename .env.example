# Supabase Configuration (DO NOT COMMIT .env with real credentials!)
# Copy this file to .env and fill in your real Supabase credentials

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key_here
USE_SUPABASE=false

# Optional: Enable auto-creation of tables on first run
SUPABASE_AUTO_CREATE_TABLES=true
